<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="8dp">

    <TextClock
        android:id="@+id/date_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="EEE, dd.MM"
        android:format24Hour="EEE, dd.MM"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:shadowColor="#FF000000"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="2.5" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/clock_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/time_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="32sp"
                android:autoSizeMaxTextSize="60sp"
                android:autoSizeStepGranularity="1sp"
                android:ellipsize="none"
                android:fontFamily="sans-serif-light"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:gravity="center_vertical|start"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#FFFFFFFF"
                android:textSize="56sp"
                android:textStyle="normal"
                android:shadowColor="#FF000000"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="3" />

            <LinearLayout
                android:id="@+id/weather_block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/weather_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:shadowColor="#FF000000"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="2"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/weather_uv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFFFF"
                    android:textSize="10sp"
                    android:shadowColor="#FF000000"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="2"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/weather_icon"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="2dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_weather_cloudy" />

                    <TextView
                        android:id="@+id/weather_temperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFFFF"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:shadowColor="#FF000000"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="2.5" />
                </LinearLayout>

                <TextView
                    android:id="@+id/weather_condition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFFFF"
                    android:textSize="10sp"
                    android:shadowColor="#FF000000"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="2"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/clock_col"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextClock
                android:id="@+id/date_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEE, dd.MM"
                android:format24Hour="EEE, dd.MM"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:shadowColor="#FF000000"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="2.5" />

            <TextClock
                android:id="@+id/time_col"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:textColor="#FFFFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:shadowColor="#FF000000"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="3" />
        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/alarm_block"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/alarm_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:shadowColor="#FF000000"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="2.5" />

        <TextView
            android:id="@+id/alarm_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="4dp"
            android:textColor="#FF687127"
            android:textSize="12sp"
            android:textStyle="bold"
            android:shadowColor="#FFFFFFFF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hourly_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone" />

</LinearLayout>
