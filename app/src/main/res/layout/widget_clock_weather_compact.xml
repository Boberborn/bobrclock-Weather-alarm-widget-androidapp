<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="8dp">

    <TextClock
        android:id="@+id/date_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="EEE, dd.MM"
        android:format24Hour="EEE, dd.MM"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:shadowColor="#FF000000"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="2.5" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/clock_row"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/time_row"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="40sp"
                android:autoSizeMaxTextSize="90sp"
                android:autoSizeStepGranularity="1sp"
                android:ellipsize="none"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#FFFFFFFF"
                android:textSize="60sp"
                android:textStyle="bold"
                android:shadowColor="#FF000000"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="3" />

            <LinearLayout
                android:id="@+id/weather_block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/weather_icon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_weather_cloudy" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/weather_temperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFFFF"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        android:shadowColor="#FF000000"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="2.5" />

                    <TextView
                        android:id="@+id/weather_condition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFE5E7EB"
                        android:textSize="10sp"
                        android:shadowColor="#FF000000"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="2.5" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/clock_col"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextClock
                android:id="@+id/date_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEE, dd.MM"
                android:format24Hour="EEE, dd.MM"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:shadowColor="#FF000000"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="2.5" />

            <TextClock
                android:id="@+id/time_col"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:textColor="#FFFFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:shadowColor="#FF000000"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="3" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/alarm_block"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/alarm_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF93C5FD"
                android:textSize="10sp"
                android:shadowColor="#FF000000"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="2.5" />

            <TextView
                android:id="@+id/alarm_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="4dp"
                android:textColor="#FF93C5FD"
                android:textSize="12sp"
                android:shadowColor="#FF000000"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="2.5" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/weather_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="#FF9CA3AF"
        android:textSize="9sp"
        android:visibility="gone"
        android:shadowColor="#FF000000"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="2.5" />

    <LinearLayout
        android:id="@+id/hourly_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone" />

</LinearLayout>
